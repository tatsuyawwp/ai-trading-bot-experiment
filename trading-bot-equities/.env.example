ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Long watchlist (mean-reversion strategy)
WATCHLIST=SPY,QQQ,TSLA,NVDA
PER_TRADE_NOTIONAL=20
MAX_TOTAL_NOTIONAL=40
CIRCUIT_BREAKER_LOSS=20

# Short watchlist - leave empty to keep short-selling dormant (recommended
# default). Only set this if you understand the overnight gap-risk and
# borrow-availability implications of short-selling.
SHORT_WATCHLIST=
SHORT_STOP_LOSS_PCT=0.04
SHORT_TAKE_PROFIT_PCT=0.07
MAX_CONCURRENT_SHORTS=1
MAX_TOTAL_EXPOSURE=100
